# ==============================================================================
# AgriFlow AI — Smart India Hackathon 2026 Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5173
VITE_APP_NAME="AgriFlow AI"
VITE_APP_VERSION="2.8.0"
VITE_DEPLOYED_URL="https://agriflow-ai-five.vercel.app"

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/agriflow_procurement"
DIRECT_URL="postgresql://postgres:your_secure_password@localhost:5432/agriflow_procurement"

# Authentication & RBAC JWT Security
JWT_SECRET="agriflow_super_secret_jwt_hmac_sha256_key_min_32_chars_long_2026"
JWT_EXPIRES_IN="8h"

# Redis Cache & Queue Broker (Upstash / Local Redis)
REDIS_URL="redis://default:your_redis_token@localhost:6379"

# Public Service Integration (SMS / USSD / IVR / NIC)
CDAC_SMS_GATEWAY_URL="https://mgov.gov.in/api/v2/sms/send"
CDAC_SMS_API_KEY="mock_nic_cdac_sms_api_key_sih2026"
TELECOM_USSD_SERVICE_CODE="*384#"
IVR_TOLL_FREE_NUMBER="18001801551"

# PFMS Direct Benefit Transfer (DBT) Integration
PFMS_GATEWAY_URL="https://pfms.nic.in/mock/api/v1/dbt_payout"
PFMS_CLIENT_ID="AGRIFLOW_TN_COIMBATORE_FCI"
PFMS_CLIENT_SECRET="mock_pfms_client_secret_2026"

# AI / ML Inference Service (Quantity-Aware Arrival & Congestion Regressor)
AI_MODEL_SERVICE_URL="http://localhost:8000/api/predict"
AI_MODEL_VERSION="v2.6-gradient-boost-flow"
WALK_IN_DEMAND_RATIO="0.25"

# Security Rate Limiter Defaults
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

